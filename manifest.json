{
  "manifest_version": 3,
  "name": "LoL Schedule",
  "version": "2.0.0",
  "description": "LoL esports match schedule with live notifications for your favorite Twitch streamers.",
  "minimum_chrome_version": "110",
  "permissions": ["alarms", "storage", "notifications"],
  "host_permissions": [
    "https://esports-api.lolesports.com/*",
    "https://static.lolesports.com/*",
    "https://gql.twitch.tv/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LoL Schedule",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
